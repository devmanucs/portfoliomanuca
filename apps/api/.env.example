# Supabase: use a connection string em Project Settings → Database
# Local Docker: postgresql://postgres:postgres@localhost:5432/portfoliomanuca?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfoliomanuca?schema=public
JWT_SECRET=change-me-in-production
FRONTEND_URL=http://localhost:3000
ADMIN_EMAIL=admin@portfolio.local
ADMIN_PASSWORD=changeme
PORT=3001
NODE_ENV=development

# Upload de imagens/vídeos (Supabase Storage): Project Settings → API
# SUPABASE_URL = "Project URL", SUPABASE_SERVICE_ROLE_KEY = "service_role" secret key.
# Crie um bucket público (Storage → New bucket) e informe o nome dele abaixo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=portfolio-media
